# ===================================
# CampusOps AI — Environment Variables
# ===================================
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=campusops
POSTGRES_USER=campusops_user
POSTGRES_PASSWORD=campusops_pass

# --- FastAPI Backend ---
SECRET_KEY=your_jwt_secret_key_min_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Backend URL (for frontend) ---
VITE_API_URL=http://localhost:8000

# --- File Upload ---
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=uploads

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@campusops.ai

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id
TELEGRAM_SUPERVISOR_CHAT_ID=your_supervisor_chat_id

# --- n8n ---
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=your_n8n_password
N8N_WEBHOOK_URL=http://localhost:5678/webhook

# --- Frontend ---
REACT_APP_NAME=CampusOps AI
REACT_APP_LANGUAGE=bn-EN

# --- Environment ---
ENVIRONMENT=development
# Change to: production
